SECRET_KEY=replace-with-a-long-random-string
# Use the postgresql+psycopg:// prefix (psycopg 3). Plain postgresql:// makes SQLAlchemy look for psycopg2.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/nexora_dev
# Must end in _test. The migration tests use a second database, <name>_schema_test
# (nexora_schema_test here), created once by you; see README "Running the tests".
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/nexora_test
FLASK_DEBUG=1
# Reverse proxies in front of the app (0 if none); needed for per-IP rate limits
TRUSTED_PROXIES=0
# Rate-limit storage. Production: redis://:PASSWORD@host:6379/0 (rediss:// for TLS;
# URL-encode special characters in the password). memory:// is for local dev only.
RATELIMIT_STORAGE_URI=memory://
