SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=postgresql+psycopg://nexora:replace-me@localhost:5432/nexora_dev
TEST_DATABASE_URL=postgresql+psycopg://nexora:replace-me@localhost:5432/nexora_test
POSTGRES_USER=nexora
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=nexora_dev
# Reverse proxies in front of the app (0 if none); needed for per-IP rate limits
TRUSTED_PROXIES=0
# Rate-limit storage. Production: redis://:PASSWORD@host:6379/0 (rediss:// for TLS;
# URL-encode special characters in the password). memory:// is for local dev only.
RATELIMIT_STORAGE_URI=memory://
