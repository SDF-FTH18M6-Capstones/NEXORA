# Thunder Client: Env tab -> menu (≡) -> Import -> your copy of this file.
# Copy this file to NEXORA-local.env and fill it in. NEXORA-local.env is ignored
# by git: it holds this machine's values, not the team's.
#
# It is a plain dotenv file, which Thunder Client reads without JSON detection.
# baseUrl has no trailing slash; every request appends /api/... itself.
baseUrl=http://localhost:5000
# The password the seed gives every account it creates (backend/scripts/seed.py).
password=put-the-seed-password-here
run=01
